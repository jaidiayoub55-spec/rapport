                    etat (recu|non_recu) "recu">
<!ATTLIST expediteur 
                    cin CDATA #REQUIRED
                    nom CDATA #REQUIRED
                    prenom CDATA #REQUIRED
                    ville CDATA #REQUIRED>
<!ATTLIST destinataire 
                    cin CDATA #REQUIRED
                    nom CDATA #REQUIRED
                    prenom CDATA #REQUIRED
                    ville CDATA #REQUIRED>